# LoreMotion
LOREMOTION_BASE_URL=https://loremotion.com

# Persistent signed-in session. The browser profile directory is the credential.
LOREMOTION_SESSION_MODE=persistent
LOREMOTION_PROFILE_DIR=.loremotion-profile
LOREMOTION_DOWNLOAD_DIR=downloads

# Recommended headless-server workflow: import a profile authenticated elsewhere.
# May point to a Chromium user-data directory or .zip/.tar/.tar.gz/.tgz archive.
# Leave blank after a one-time import if you do not want Hermes to re-import automatically.
LOREMOTION_PROFILE_IMPORT_PATH=

# Headless Linux / Playwright Chromium headless shell.
LOREMOTION_HEADLESS=true

# A bare executable path wins over LOREMOTION_BROWSER_CHANNEL. If blank, the code
# also honors PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH when that env var is already set.
LOREMOTION_EXECUTABLE_PATH=

# Leave empty on a headless server with no installed browser channel. Desktop users
# may set this to chrome and LOREMOTION_HEADLESS=false for interactive npm run login.
LOREMOTION_BROWSER_CHANNEL=

# Comma-separated Chromium launch args used for BOTH ephemeral and persistent launches.
LOREMOTION_LAUNCH_ARGS=--no-sandbox,--disable-dev-shm-usage,--disable-gpu,--single-process

LOREMOTION_TIMEOUT_MS=30000
LOREMOTION_GENERATION_TIMEOUT_MS=600000
LOREMOTION_SLOW_MO_MS=0

# Defaults only. The live duration slider is authoritative; use loremotion_probe_ui
# to inspect durationSliderMax before requesting a duration.
LOREMOTION_LTX_DEFAULT_DURATION=5
LOREMOTION_H3_DEFAULT_DURATION=5

# Optional selector overrides if LoreMotion changes its UI.
# Example: {"prompt":["textarea[name=prompt]"],"generate":["button[data-testid=generate]"]}
LOREMOTION_SELECTORS_JSON={}

# Playwright itself can also be configured externally on a VPS, for example:
# PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/opt/ms-playwright/chromium_headless_shell-*/chrome-linux/headless_shell
